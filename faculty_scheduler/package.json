  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "@hono/node-server": "^2.1.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "hono": "^4.13.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  }
}
