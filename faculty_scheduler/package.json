{
  "name": "k12-faculty-scheduler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:wrangler": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "migrate:local": "wrangler d1 migrations apply DB --local",
